* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #f4f4f4;
  color: #222;
  line-height: 1.6;
}

header {
  background-color: #1f4e79;
  color: white;
  padding: 20px;
  text-align: center;
}

nav a {
  color: white;
  margin: 0 10px;
  text-decoration: none;
}

nav a:hover,
nav a:focus {
  text-decoration: underline;
}

main {
  max-width: 900px;
  margin: 30px auto;
  padding: 20px;
  background-color: white;
}

section {
  margin-bottom: 30px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

input,
button {
  padding: 10px;
  font-size: 16px;
}

button {
  background-color: #1f4e79;
  color: white;
  border: none;
  cursor: pointer;
}

button:hover,
button:focus {
  background-color: #163a5c;
}

footer {
  text-align: center;
  padding: 20px;
  background-color: #222;
  color: white;
}
